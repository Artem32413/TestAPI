{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "This is a sample API Go server with Zap logging",
        "title": "API Go Service",
        "contact": {
            "name": "API Support",
            "url": "http://www.example.com/support",
            "email": "support@example.com"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:8082",
    "basePath": "/api/v1",
    "paths": {
        "/products/add/": {
            "post": {
                "description": "Создает новую запись товара в системе",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Products"
                ],
                "summary": "Добавить новый товар",
                "parameters": [
                    {
                        "description": "Данные нового товара",
                        "name": "product",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/structs.Products"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Товар успешно добавлен"
                    },
                    "400": {
                        "description": "Неверные входные данные"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера"
                    }
                }
            }
        },
        "/products/all/": {
            "get": {
                "description": "Возвращает список всех товаров в системе без привязки к складам",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Products"
                ],
                "summary": "Получить все товары",
                "responses": {
                    "200": {
                        "description": "Список товаров",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/structs.Products"
                            }
                        }
                    },
                    "400": {
                        "description": "Ошибка в запросе"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера"
                    }
                }
            }
        },
        "/products/update/": {
            "put": {
                "description": "Обновляет описание и характеристики существующего товара",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Products"
                ],
                "summary": "Обновить товар",
                "parameters": [
                    {
                        "description": "Обновленные данные товара",
                        "name": "product",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/structs.Products"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Товар успешно обновлен"
                    },
                    "400": {
                        "description": "Неверные входные данные"
                    },
                    "404": {
                        "description": "Товар не найден"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера"
                    }
                }
            }
        }
    },
    "definitions": {
        "structs.Products": {
            "description": "Основная информация о товаре в системе",
            "type": "object",
            "properties": {
                "barcode": {
                    "description": "Штрих-код товара",
                    "type": "string",
                    "example": "123456789012"
                },
                "description": {
                    "description": "Описание товара",
                    "type": "string",
                    "example": "Флагманский смартфон 2023 года"
                },
                "keyvalue": {
                    "description": "Характеристики товара (ключ-значение)",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                },
                "name": {
                    "description": "Наименование товара",
                    "type": "string",
                    "example": "Смартфон"
                },
                "productId": {
                    "description": "Уникальный идентификатор товара",
                    "type": "string",
                    "example": "PRD-1001"
                },
                "weight": {
                    "description": "Вес товара",
                    "type": "string",
                    "example": "0.2"
                }
            }
        }
    }
}